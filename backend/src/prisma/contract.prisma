// use prisma-next

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  role     String @default("USER")
  password  String
  name      String?
  documents Document[]
  sessions  Session[]
  batches   Batch[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}


model DocumentType {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  domain      String
  description String?
  documents   Document[]
  versions    DocumentTypeVersion[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model DocumentTypeVersion {
  id             Int          @id @default(autoincrement())
  documentTypeId Int
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  versionNumber  Int
  jsonSchema     Json
  status         String       @default("DRAFT")
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
  publishedAt    TimestamptzString?
  fields         Field[]
  documents      Document[]
}

model Document {
  id             Int @id @default(autoincrement())
  fileName       String
  filePath       String
  mimeType       String
  documentTypeId Int?
  documentType   DocumentType? @relation(fields: [documentTypeId], references: [id])
  documentTypeVersionId Int?
  documentTypeVersion DocumentTypeVersion? @relation(fields: [documentTypeVersionId], references: [id])
  userId         Int
  user           User @relation(fields: [userId], references: [id])

  batchId        Int?
  batch          Batch? @relation(fields: [batchId], references: [id])

  status         String @default("PENDING")
  activeWorkerId Int?
  claimExpiresAt TimestamptzString?
  extractedText  String?
  parseStatus    String @default("PENDING")
  parseMessage   String?
  draftData      Json?
  generatedJSON  GeneratedJSON?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  instances DocumentInstance[]
}

model Field {
  id             Int          @id @default(autoincrement())
  name           String
  type           String
  required       Boolean      @default(false)
  validationRule String?
  documentTypeVersionId Int
  documentTypeVersion   DocumentTypeVersion @relation(fields: [documentTypeVersionId], references: [id])
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model GeneratedJSON {
  id         Int        @id @default(autoincrement())
  data       Json
  isValid    Boolean    @default(false)
  documentId Int        @unique
  document   Document   @relation(fields: [documentId], references: [id])
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())
}

model Batch {
  id        Int        @id @default(autoincrement())
  userId    Int
  user      User       @relation(fields: [userId], references: [id])
  status    String     @default("ACTIVE")
  documents Document[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model DocumentInstance {
  id              Int      @id @default(autoincrement())

   documentId Int
  document   Document @relation(
    fields: [documentId],
    references: [id],
    onDelete: Cascade
  )

  position        Int
  startPage       Int
  endPage         Int

  detectionMethod String?
  detectionScore  Int?

  extractedText   String?
  status          String   @default("DRAFT")
  draftData       Json?

  generatedJSON   Json?

  createdAt TimestamptzString @default(now())
updatedAt temporal.updatedAtString()
}
