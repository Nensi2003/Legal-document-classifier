  {
    "id": "data.document-type-version-v1-backfill",
    "label": "Backfill existing document type versions",
    "summary": "Copies existing schemas, fields, and document version links into version 1.",
    "operationClass": "data",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "documentTypeVersion"
      }
    },
    "precheck": [],
    "execute": [
      {
        "description": "copy legacy document types, fields, and documents to version 1",
        "sql": "INSERT INTO \"public\".\"documentTypeVersion\" (\"documentTypeId\", \"versionNumber\", \"jsonSchema\", \"status\", \"publishedAt\", \"updatedAt\")\nSELECT dt.\"id\", 1, dt.\"jsonSchema\", 'ACTIVE', now(), now()\nFROM \"public\".\"documentType\" dt\nWHERE NOT EXISTS (SELECT 1 FROM \"public\".\"documentTypeVersion\" v WHERE v.\"documentTypeId\" = dt.\"id\" AND v.\"versionNumber\" = 1);\nUPDATE \"public\".\"document\" d SET \"documentTypeVersionId\" = v.\"id\"\nFROM \"public\".\"documentTypeVersion\" v\nWHERE d.\"documentTypeId\" = v.\"documentTypeId\" AND v.\"versionNumber\" = 1 AND d.\"documentTypeVersionId\" IS NULL;\nUPDATE \"public\".\"field\" f SET \"documentTypeVersionId\" = v.\"id\"\nFROM \"public\".\"documentTypeVersion\" v\nWHERE f.\"documentTypeId\" = v.\"documentTypeId\" AND v.\"versionNumber\" = 1 AND f.\"documentTypeVersionId\" IS NULL;\nCREATE UNIQUE INDEX \"documentTypeVersion_type_version_key\" ON \"public\".\"documentTypeVersion\" (\"documentTypeId\", \"versionNumber\");\nCREATE UNIQUE INDEX \"documentTypeVersion_one_active_per_type_key\" ON \"public\".\"documentTypeVersion\" (\"documentTypeId\") WHERE \"status\" = 'ACTIVE';"
      }
    ],
    "postcheck": []
  },
